# ns-lite Production Configuration
# Copy to .env and fill in values before deploying.

# Database (PostgreSQL required for production)
DATABASE_URL=postgresql://netscan:CHANGE_ME@localhost:5432/netscan
DB_PASSWORD=CHANGE_ME

# Authentication (LDAP required for production)
LDAP_ENABLED=true
LDAP_SERVER=ldap://your-ldap-server
LDAP_BIND_DN=cn=ns-lite-service,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USE_SSL=true

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_EXPIRY_HOURS=24

# CORS (comma-separated origins, or * for dev only)
CORS_ORIGINS=https://ns-lite.yourcompany.com

# Server
WORKERS=4
DEBUG=false

# Monitoring (Prometheus metrics endpoint at /metrics)
ENABLE_METRICS=false
LOG_JSON=false
