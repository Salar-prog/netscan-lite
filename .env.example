# ns-lite configuration
DATABASE_URL=sqlite:///./ns-lite.db
DEBUG=false

# Scanner defaults
DEFAULT_MISS_THRESHOLD=3
DEFAULT_QUARANTINE_HOURS=48
NMAP_TIMEOUT_SECONDS=300
NMAP_TIMING_TEMPLATE=-T4
TOP_TCP_PORTS=80,443,22,445,3389,8080,8443,53

# LDAP authentication (disabled by default for local dev)
LDAP_ENABLED=false
LDAP_SERVER=ldap://localhost
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=dc=example,dc=com
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_STARTTLS=false

# JWT (auto-generated secret if not set)
# JWT_SECRET_KEY=your-secret-key-here
JWT_EXPIRY_HOURS=24
